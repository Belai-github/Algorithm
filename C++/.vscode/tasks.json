				"showReuseMessage": true,
			}
		},
		{
			"type": "shell",
			"label": "Copy testcases",
			"command": "bash",
			"args": [
				"-c",
				"../script/copy.sh ${fileBasenameNoExtension}"
			],
			"group": {
				"kind": "build",
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": true,
			}
		},
		{
			"type": "shell",
			"label": "Build and Test (g++)",
			"dependsOn": [
				"Build (g++)",
				"Test"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": false
			},
		},
		{
			"type": "shell",
			"label": "Build and Test (clang++)",
