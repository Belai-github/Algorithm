    "Monoid": {
        "prefix": "mo",
        "body": [
            "TYPE = TypeVar('TYPE')",
            "",
            "",
            "class monoid_super(Generic[TYPE]):",
            "    Base: type[TYPE]                       # ベースの型",
            "    identity: TYPE                         # 単位元",
            "    combine: Callable[[TYPE, TYPE], TYPE]  # モノイド演算",
            "    __slots__ = ('value',)                 # メモリ削減",
            "    value: TYPE",
            "",
            "    def __init__(self, *args: Any):",
            "        if not args:",
            "            self.value = self.identity",
            "        elif len(args) == 1 and isinstance(args[0], monoid_super):",
            "            self.value = cast(monoid_super[TYPE], args[0]).value",
            "        else:",
            "            raw = args[0] if len(args) == 1 else args",
            "            self.value = cast(TYPE, raw)",
            "",
            "    def __mul__(self, other):",
            "        if other.__class__ is not self.__class__:",
            "            return NotImplemented",
            "        if self.value is self.identity:",
            "            return other",
            "        if other.value is self.identity:",
            "            return self",
            "        combine = self.__class__.combine",
            "        new_val = combine(self.value, other.value)",
            "        return type(self)(new_val)",
            "",
            "    def __getitem__(self, x: Any):",
            "        return self.value[x]  # type: ignore[index]",
            "",
            "    def __iter__(self):",
            "        return iter(cast(Iterable[Any], self.value))",
            "",
            "    def __repr__(self):",
            "        return f'{self.value}'",
            "",
            "    @classmethod",
            "    def all_product(cls, iterable):",
            "        return reduce(lambda a, b: a * b,",
            "                      (cls(x) for x in iterable),",
            "                      cls())",
            "",
            "",
            "class monoid(monoid_super[int]):",
            "",
            "    Base = int",
            "    identity = 0",
            "",
            "    @staticmethod",
            "    def combine(a, b):",
            "        return max(a, b)",
        ],
        "description": "Monoid"
    },
