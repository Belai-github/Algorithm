    "Rerooting DP": {
        "prefix": "rer",
        "body": [
            "class Rerooting:",
            "    def __init__(self, graph: List[List[int]],",
            "                 transition: Callable[['monoid', int, int], 'monoid'],",
            "                 merge: Callable[['monoid', int], 'monoid'],",
            "                 identity: 'monoid') -> None:",
            "        self.graph = graph",
            "        self.n = len(graph)",
            "        self.dp: List[monoid] = [monoid() for _ in range(self.n)]",
            "        self.ans: List[monoid] = [monoid() for _ in range(self.n)]",
            "        self.parent: List[int] = [-1] * self.n",
            "        self.order: List[int] = []",
            "        self.transition = transition",
            "        self.merge = merge",
            "        self.id = identity",
            "        self._dfs_order()",
            "        self._dfs_reverse()",
            "        self._dfs_rerooting()",
            "",
            "    def _dfs_order(self) -> None:",
            "        stack = [0]",
            "        self.parent[0] = -1",
            "        while stack:",
            "            v = stack.pop()",
            "            self.order.append(v)",
            "            for nv in self.graph[v]:",
            "                if nv == self.parent[v]:",
            "                    continue",
            "                self.parent[nv] = v",
            "                stack.append(nv)",
            "        self.order.reverse()",
            "",
            "    def _dfs_reverse(self) -> None:",
            "        transition = self.transition",
            "        merge = self.merge",
            "        id_ = self.id",
            "        graph = self.graph",
            "        parent = self.parent",
            "        dp = self.dp",
            "        for v in self.order:",
            "            res = id_",
            "            for nv in graph[v]:",
            "                if nv == parent[v]:",
            "                    continue",
            "                res = res * transition(dp[nv], nv, v)",
            "            dp[v] = merge(res, v)",
            "",
            "    def _dfs_rerooting(self) -> None:",
            "        transition = self.transition",
            "        merge = self.merge",
            "        id_ = self.id",
            "        graph = self.graph",
            "        parent = self.parent",
            "        dp = self.dp",
            "        ans = self.ans",
            "        stack = [(0, id_)]",
            "        while stack:",
            "            v, acc_from_parent = stack.pop()",
            "            children = [nv for nv in graph[v] if nv != parent[v]]",
            "            k = len(children)",
            "            transed = [transition(dp[c], c, v) for c in children]",
            "            prefix: List[monoid] = [id_]",
            "            for t in transed:",
            "                prefix.append(prefix[-1] * t)",
            "            suffix: List[monoid] = [id_] * (k + 1)",
            "            for i in range(k - 1, -1, -1):",
            "                suffix[i] = transed[i] * suffix[i + 1]",
            "            ans[v] = merge(acc_from_parent * prefix[k], v)",
            "            for i, child in enumerate(children):",
            "                without_i = prefix[i] * suffix[i + 1]",
            "                new_acc = merge(acc_from_parent * without_i, v)",
            "                stack.append((child, transition(new_acc, v, child)))",
        ]
    },
    "Twelvefold way": {
        "prefix": "twe",
        "body": [
            "# https://atcoder.jp/contests/abc404/submissions/66206189",
            "# ChatGPTにより生成+改良したライブラリ。コンテスト開始前に生成した証拠の提出URL",
            "def twelvefold_way(n: int, k: int,",
            "    domain_distinct: bool,",
            "    codomain_distinct: bool,",
            "    restriction: str = 'n'):",
            "    '''",
            "    写像12相の各同値類の完全代表系のイテレータを返す",
            "    - n: 始域の濃度",
            "    - k: 終域の濃度",
            "    - domain_distinct: 始域の区別有無",
            "    - codomain_distinct: 終域の区別有無",
            "    - restriction: 'i'(単射 injective) | 'n'(制限なし none) | 's'(全射 surjective)",
            "    イテレータの戻り値は以下のいずれか",
            "    * 始域区別・終域区別：長さ n のタプル f, f[i] = 始域要素iが入る終域要素",
            "    * 始域不区別・終域区別：長さ k のタプル c, c[j] = 終域要素jに入る始域要素の個数",
            "    * 始域区別・終域不区別：集合分割 (list[list[始域要素]])",
            "    * 始域不区別・終域不区別：整数分割 (dict{i:分割内のiの個数})",
            "    '''",
            "",
            "    def _int_parts(n, k, max_val=None):",
            "        if max_val is None:",
            "            max_val = n",
            "        if k == 0:",
            "            if n == 0:",
            "                yield {}",
            "            return",
            "        if k > 0 and n > 0:",
            "            for i in range(n // k, min(n - (k - 1), max_val) + 1):",
            "                for d in _int_parts(n - i, k - 1, i):",
            "                    d_ = defaultdict(int, d)",
            "                    d_[i] += 1",
            "                    yield dict(d_)",
            "",
            "    def _int_parts_le(n, k):",
            "        for r in range(1, k + 1):",
            "            for d in _int_parts(n, r):",
