            "def Run_Length_Encoding(A):",
            "    res = []",
            "    if A:",
            "        pre = A[0]",
            "        temp = 0",
            "        for a in A:",
            "            if a == pre:",
            "                temp += 1",
            "            else:",
            "                res.append((temp, pre))",
            "                pre = a",
            "                temp = 1",
            "        res.append((temp, pre))",
            "    return res",
        ],
