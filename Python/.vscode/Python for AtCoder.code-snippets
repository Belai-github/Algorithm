    "BinaryIndexedTree": {
        "prefix": "bit",
        "body": [
            "class BinaryIndexedTree:",
            "    # 長さN+1の配列を初期化",
            "    def __init__(self, N) -> None:",
            "        self.size = N",
            "        self.bit = [0] * N",
            "",
            "    # i番目までの和を求める",
            "    def sum(self, i):",
            "        res = 0",
            "        while i > 0:",
            "            res += self.bit[i - 1]  # フェニック木のi番目の値を加算",
            "            i -= -i & i  # 最も右にある1の桁を0にする",
            "        return res",
            "",
            "    # i番目の値にxを足して更新する",
            "    def add(self, i, x):",
            "        while i <= self.size:",
            "            self.bit[i - 1] += x  # フェニック木のi番目にxを足して更新",
            "            i += -i & i  # 最も右にある1の桁に1を足す",
        ],
        "description": "Binary Indexed Tree (Fenwic Tree)"
    },
    "ModInt": {
        "prefix": "mint",
        "body": [
            "class ModInt:",
            "    def __init__(self, x, MOD=998244353) -> None:",
            "        self.mod = MOD",
            "        self.x = int(x) % MOD",
            "",
            "    def inv(self):",
            "        return pow(self.x, self.mod - 2, self.mod)",
            "",
            "    def __str__(self):",
            "        return str(self.x)",
            "",
            "    __repr__ = __str__",
            "",
            "    def __add__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(self.x + other.x, self.mod)",
            "            if isinstance(other, ModInt)",
            "            else ModInt(self.x + other, self.mod)",
            "        )",
            "",
            "    def __sub__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(self.x - other.x, self.mod)",
            "            if isinstance(other, ModInt)",
            "            else ModInt(self.x - other, self.mod)",
            "        )",
            "",
            "    def __mul__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(self.x * other.x, self.mod)",
            "            if isinstance(other, ModInt)",
            "            else ModInt(self.x * other, self.mod)",
            "        )",
            "",
            "    def __truediv__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "        ModInt(self.x * other.inv(), self.mod)",
            "        if isinstance(other, ModInt)",
            "        else ModInt(self.x * ModInt(other).inv(), self.mod)",
            "        )",
            "    __floordiv__ = __truediv__",
            "",
            "    def __pow__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(pow(self.x, other.x, self.mod), self.mod)",
            "            if isinstance(other, ModInt)",
            "            else ModInt(pow(self.x, other, self.mod), self.mod)",
            "        )",
            "",
            "    __radd__ = __add__",
            "",
            "    def __rsub__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(other.x - self.x, self.mod)",
            "            if isinstance(other, ModInt)",
            "            else ModInt(other - self.x, self.mod)",
            "        )",
            "",
            "    __rmul__ = __mul__",
            "",
            "    def __rtruediv__(self, other):",
            "        if isinstance(other, ModInt):",
            "            assert self.mod == other.mod",
            "",
            "        return (",
            "            ModInt(other.x * self.inv())",
            "            if isinstance(other, ModInt)",
